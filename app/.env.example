# Privy app (create at dashboard.privy.io; enable Robinhood Chain 4663 as a custom chain)
NEXT_PUBLIC_PRIVY_APP_ID=

# Deployed contract addresses on Robinhood Chain (from contracts/deployments/grood-robinhood.json)
NEXT_PUBLIC_GROOD_ADDR=
NEXT_PUBLIC_GROOD_TOKEN_ADDR=

# Optional dedicated RPC (e.g. https://robinhood-mainnet.g.alchemy.com/v2/KEY); public RPC used as fallback
NEXT_PUBLIC_ALCHEMY_RPC=

# Keeper SSE feed (e.g. https://your-keeper.up.railway.app/events); empty = RPC polling only
NEXT_PUBLIC_SSE_URL=

# Supabase history mirror (optional; empty = history table hidden)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON=

# Set to "true" only if Privy gas sponsorship is configured for chain 4663
NEXT_PUBLIC_GAS_SPONSOR=false
