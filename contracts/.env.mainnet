# ═══════════════════════════════════════════════════════════════
# Grood — Robinhood Chain Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Deployer wallet private key (with 0x prefix) — needs ETH on Robinhood Chain for gas
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# RPCs (public defaults; Alchemy robinhood-mainnet.g.alchemy.com/v2/KEY also works)
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com

# Fee recipient for the 5% protocol fee (defaults to deployer if unset)
FEE_RECIPIENT=

# Entry token override (defaults to canonical USDG on 4663)
# USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
